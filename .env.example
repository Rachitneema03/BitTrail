# Copy to .env and fill in. Never commit .env.

# Database. Omit for local SQLite (backend/bittrail.db).
# Supabase: Dashboard -> Connect -> "Session pooler" (IPv4). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string used to sign login tokens
JWT_SECRET=change-me

# Optional API keys
TRONGRID_API_KEY=          # higher Tron rate limits (works without a key)
ETHERSCAN_API_KEY=         # optional: Ethereum + Polygon work without it (Blockscout public API fallback)
ETHERSCAN_BSC=false        # true if the Etherscan key is a paid tier that covers BNB Chain (chainid 56) ...
BSC_API_BASE=              # ... or any Etherscan-compatible BNB Chain API base URL (+ BSC_API_KEY)
BSC_API_KEY=
BLOCKSCOUT_FALLBACK=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # public RPC works (slow); a free Helius RPC URL is much faster

# Cross-chain: public bridge / swap trackers, looked up by source transaction hash (free, no keys)
BRIDGE_TRACKER=true
CROSSCHAIN_PROVIDERS=lifi,thorchain,debridge,wormhole
THORCHAIN_MIDGARD_URL=https://gateway.liquify.com/chain/thorchain_midgard/v2

# Sarvam AI (optional): case summaries, "Ask this case", Hindi translation. Never used for attribution.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b   # or sarvam-30b

# true = serve blockchain data only from the cache (offline demo; no API calls)
DEMO_MODE=false

# Optional tuning (defaults shown)
# TRACE_MAX_DEPTH=5
# TRACE_FANOUT=5
# TRACE_MIN_USD=10
# TRACE_MAX_EDGES=2000
# TRACE_WINDOW_DAYS=90
# TRACE_BACK_DEPTH=2
# WATCH_INTERVAL_SECONDS=120
# CORS_ORIGINS=*
